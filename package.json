{
	"name": "demo",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vp dev",
		"dev:host": "vp dev --host",
		"build": "vp build",
		"preview": "vp preview",
		"bp": "vp build && vp preview",
		"bp:host": "vp build && vp preview --host",
		"prepare": "vp config --no-agent; svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.48.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.12",
		"vite-plus": "1.0.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.2",
			"onFail": "download"
		}
	}
}
