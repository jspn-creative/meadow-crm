{
	"name": "demo",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "node --experimental-strip-types scripts/dev-live.ts",
		"dev:live": "node --experimental-strip-types scripts/dev-live.ts",
		"dev:local": "alchemy dev --stage dev --env-file .dev.vars",
		"dev:host": "MEADOW_DEV_HOST=0.0.0.0 alchemy dev --stage dev --env-file .dev.vars",
		"build": "node --experimental-strip-types scripts/build.ts",
		"preview": "vp preview",
		"bp": "vp run build && vp preview",
		"bp:host": "vp run build && vp preview --host",
		"prepare": "vp config --no-agent; svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:shell": "playwright test",
		"test:runtime": "node --experimental-strip-types scripts/runtime-smoke.ts",
		"test:production": "node --experimental-strip-types scripts/production-smoke.ts",
		"test:db": "vp test src/lib/server/db",
		"test:auth": "node --experimental-strip-types scripts/auth-smoke.ts",
		"vocabulary": "node --experimental-strip-types scripts/vocabulary.ts",
		"auth:create": "node --experimental-strip-types scripts/auth-users.ts create",
		"auth:reset-password": "node --experimental-strip-types scripts/auth-users.ts reset-password",
		"db:seed-remote": "node --experimental-strip-types scripts/seed-defaults.ts --remote",
		"db:seed": "node --experimental-strip-types scripts/local-db.ts seed",
		"db:help": "node --experimental-strip-types scripts/local-db.ts help",
		"db:seed-fictional": "node --experimental-strip-types scripts/local-db.ts seed-fictional",
		"db:reset-fictional": "node --experimental-strip-types scripts/local-db.ts reset-fictional",
		"db:pull-prod": "node --experimental-strip-types scripts/pull-prod.ts",
		"db:import-clients": "node --experimental-strip-types scripts/import-clients.ts",
		"deploy": "node --experimental-strip-types scripts/deploy.ts",
		"preview:data": "node --experimental-strip-types scripts/preview-data.ts",
		"state:bootstrap": "node --experimental-strip-types scripts/bootstrap-state.ts"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.7.7",
		"@humanspeak/svelte-motion": "^2.0.0",
		"@tanstack/svelte-table": "^9.3.1",
		"better-auth": "^1.7.7",
		"drizzle-orm": "1.0.0-rc.5-ab785fc",
		"modern-screenshot": "^4.7.0",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@alchemy.run/cloudflare": "2.0.0-beta.84",
		"@alchemy.run/cloudflare-runtime": "2.0.0-beta.84",
		"@alchemy.run/drizzle": "2.0.0-beta.84",
		"@alchemy.run/frontend-frameworks": "2.0.0-beta.84",
		"@alchemy.run/github": "2.0.0-beta.84",
		"@cloudflare/workers-types": "^5.20261013.1",
		"@effect/platform-node": "4.0.5",
		"@effect/platform-node-shared": "4.0.5",
		"@lucide/svelte": "^1.48.0",
		"@playwright/test": "^1.64.0",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.5",
		"alchemy": "2.0.0-beta.84",
		"devalue": "^6.0.3",
		"drizzle-kit": "1.0.0-rc.5-ab785fc",
		"effect": "4.0.5",
		"esbuild": "^0.28.2",
		"miniflare": "^4.20260730.0",
		"svelte": "https://pkg.svelte.dev/svelte/c/7fbce7d8719e9b3a2909e32555ff4c1e16f2637a",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.12",
		"vite-plus": "1.0.0",
		"wrangler": "^4.150.0"
	},
	"overrides": {
		"@effect/platform-node-shared": "4.0.5",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.2",
			"onFail": "download"
		}
	},
	"patchedDependencies": {
		"@alchemy.run/cloudflare@2.0.0-beta.84": "patches/@alchemy.run%2Fcloudflare@2.0.0-beta.84.patch",
		"@alchemy.run/cloudflare-runtime@2.0.0-beta.84": "patches/@alchemy.run%2Fcloudflare-runtime@2.0.0-beta.84.patch"
	}
}
