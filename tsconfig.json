{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"types": ["node"],
		"paths": {
			"#lib": ["./src/lib/index.ts"],
			"#lib/*": ["./src/lib/*"]
		},
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true
	},
	"include": ["src", "alchemy.run.ts", "alchemy.live.ts"]
}
