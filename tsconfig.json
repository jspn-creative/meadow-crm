{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"types": ["node", "$app/types"],
		"paths": {
			"#lib": ["./src/lib/index.ts"],
			"#lib/*": ["./src/lib/*"]
		},
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true
	},
	"include": [
		"src",
		"alchemy.run.ts",
		"alchemy.live.ts",
		"stacks/preview-data.ts",
		"scripts/preview-data.ts"
	]
}
