{
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "npm.scriptRunner": "vp",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[svelte]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "oxc.fmt.configPath": "./vite.config.ts",
  "oxc.path.oxfmt": "./node_modules/vite-plus/bin/oxfmt",
  "oxc.path.oxlint": "./node_modules/vite-plus/bin/oxlint",
  "oxc.fmt.disableNestedConfig": true,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always"
  },
  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "#1c262a",
    "titleBar.activeForeground": "#e7f1f4",
    "titleBar.inactiveBackground": "#1a1f22",
    "titleBar.inactiveForeground": "#4d6261"
  }
}
